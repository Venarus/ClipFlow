# Auto detect text files and perform LF normalization
* text=auto

# C# and XAML sources
*.cs text diff=csharp eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf

# Markdown and text documentation
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.iss text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# Binary Assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
