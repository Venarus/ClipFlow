<Window x:Class="ClipFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClipFlow.App.ViewModels"
        xmlns:models="clr-namespace:ClipFlow.Core.Models;assembly=ClipFlow.Core"
        mc:Ignorable="d"
        Title="ClipFlow — Smart Clipboard Manager"
        Height="720" Width="1100"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Item Context Menu -->
        <ContextMenu x:Key="ItemContextMenu">
            <MenuItem Header="Copy to Clipboard" Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCopy}" Fill="{StaticResource BrushTextPrimary}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Favorite" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconStar}" Fill="#EAB308" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Pin" Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconPin}" Fill="{StaticResource BrushAccent}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Open in Browser" Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}"
                      Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding TextContent}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconOpenExternal}" Fill="{StaticResource BrushTextPrimary}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Save Image As..." Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"
                      Command="{Binding DataContext.SaveImageAsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconExport}" Fill="{StaticResource BrushTextPrimary}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Delete" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconTrash}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <!-- Outer Glass Chrome Container -->
    <Border x:Name="WindowFrame"
            Background="{StaticResource BrushBackground}"
            BorderBrush="{StaticResource BrushCardBorder}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" /> <!-- Custom Title Bar -->
                <RowDefinition Height="*" />  <!-- Main App Workspace -->
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM TITLE BAR -->
            <Border Grid.Row="0"
                    x:Name="TitleBar"
                    Background="#10FFFFFF"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="pack://application:,,,/ClipFlow.App;component/Assets/app-icon.png"
                               Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="ClipFlow"
                                   FontFamily="{StaticResource FluentFont}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                        <Border Background="#253B82F6" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" />
                        </Border>
                    </StackPanel>

                    <!-- Center Monitoring Status Pill -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource FluentSubtleButton}"
                                Command="{Binding ToggleMonitoringCommand}"
                                Padding="10,4" Height="28">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Glowing status dot -->
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#22C55E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                    <Setter Property="Fill" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding MonitoringStatusText}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Always On Top Toggle -->
                        <Button Style="{StaticResource FluentIconButton}"
                                Click="AlwaysOnTopButton_Click"
                                ToolTip="Toggle Always On Top"
                                Margin="0,0,4,0">
                            <Path Data="{StaticResource IconPin}" Fill="{StaticResource BrushTextSecondary}" Width="13" Height="13" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource FluentTitlebarButton}" Click="MinimizeButton_Click">
                            <Path Data="{StaticResource IconMinimize}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="2" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource FluentTitlebarButton}" Click="MaximizeRestoreButton_Click">
                            <Rectangle Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1" Width="10" Height="10" />
                        </Button>
                        <Button Style="{StaticResource FluentCloseTitlebarButton}" Click="CloseButton_Click">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN APP CONTENT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="170" MaxWidth="240" /> <!-- Sidebar -->
                    <ColumnDefinition Width="*" MinWidth="360" />                    <!-- List View -->
                    <ColumnDefinition Width="340" MinWidth="280" MaxWidth="480" /> <!-- Preview Panel -->
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        Background="#0DFFFFFF"
                        BorderBrush="{StaticResource BrushCardBorder}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="6,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nav List -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="HISTORY"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="12,6,0,6" />

                                <RadioButton Style="{StaticResource FluentNavButton}"
                                             GroupName="SidebarSections"
                                             IsChecked="{Binding CurrentSection, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=All}"
                                             Command="{Binding SelectSectionCommand}" CommandParameter="All">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAll}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="All Items" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource FluentNavButton}"
                                             GroupName="SidebarSections"
                                             IsChecked="{Binding CurrentSection, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=Text}"
                                             Command="{Binding SelectSectionCommand}" CommandParameter="Text">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconText}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="Text" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource FluentNavButton}"
                                             GroupName="SidebarSections"
                                             IsChecked="{Binding CurrentSection, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=Images}"
                                             Command="{Binding SelectSectionCommand}" CommandParameter="Images">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconImage}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="Images" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource FluentNavButton}"
                                             GroupName="SidebarSections"
                                             IsChecked="{Binding CurrentSection, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=Links}"
                                             Command="{Binding SelectSectionCommand}" CommandParameter="Links">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconLink}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="Links" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource FluentNavButton}"
                                             GroupName="SidebarSections"
                                             IsChecked="{Binding CurrentSection, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=Files}"
                                             Command="{Binding SelectSectionCommand}" CommandParameter="Files">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="Files" />
                                    </StackPanel>
                                </RadioButton>

                                <TextBlock Text="ORGANIZATION"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="12,18,0,6" />

                                <RadioButton Style="{StaticResource FluentNavButton}"
                                             GroupName="SidebarSections"
                                             IsChecked="{Binding CurrentSection, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=Favorites}"
                                             Command="{Binding SelectSectionCommand}" CommandParameter="Favorites">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconStar}" Fill="#EAB308" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="Favorites" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource FluentNavButton}"
                                             GroupName="SidebarSections"
                                             IsChecked="{Binding CurrentSection, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=Pinned}"
                                             Command="{Binding SelectSectionCommand}" CommandParameter="Pinned">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPin}" Fill="{StaticResource BrushAccent}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="Pinned" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource FluentNavButton}"
                                             GroupName="SidebarSections"
                                             IsChecked="{Binding CurrentSection, Mode=TwoWay, Converter={StaticResource EqualityToBool}, ConverterParameter=RecentlyUsed}"
                                             Command="{Binding SelectSectionCommand}" CommandParameter="RecentlyUsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRecent}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="Recently Used" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Settings & Stats -->
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <RadioButton Style="{StaticResource FluentNavButton}"
                                         GroupName="SidebarSections"
                                         IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}"
                                         Command="{Binding SelectSectionCommand}" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="Settings" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Storage Indicator Card -->
                            <Border Background="#12FFFFFF" CornerRadius="6" Padding="10,8" Margin="4,8,4,0">
                                <StackPanel>
                                    <TextBlock Text="Local Storage" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding StorageStats.TotalItemCount, StringFormat='{}{0} items stored'}"
                                               FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN CLIPBOARD LIST COLUMN -->
                <Grid Grid.Column="1" Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Search and Quick Filter Bar -->
                        <RowDefinition Height="Auto" /> <!-- Active Section Title & Stats Banner -->
                        <RowDefinition Height="Auto" /> <!-- Multi-select Bar (if active) -->
                        <RowDefinition Height="*" />    <!-- Virtualized History List -->
                    </Grid.RowDefinitions>

                    <!-- Search and Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource FluentSearchBox}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" />

                        <!-- Multi-select Mode Toggle -->
                        <Button Grid.Column="1"
                                Style="{StaticResource FluentSubtleButton}"
                                Command="{Binding ToggleMultiSelectCommand}"
                                ToolTip="Toggle Multi-Select Mode"
                                Margin="8,0,0,0" Height="36" Padding="10,0">
                            <Path Data="{StaticResource IconCheck}" Fill="{StaticResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>

                        <!-- Clear All History -->
                        <Button Grid.Column="2"
                                Style="{StaticResource FluentSubtleButton}"
                                Command="{Binding ClearAllHistoryCommand}"
                                ToolTip="Clear Unpinned History"
                                Margin="8,0,0,0" Height="36" Padding="10,0">
                            <Path Data="{StaticResource IconTrash}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Active Section Title Banner -->
                    <Grid Grid.Row="1" Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SectionDisplayName}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <Border Background="#203B82F6" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} items'}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Multi-select Action Bar -->
                    <Border Grid.Row="2"
                            Background="#253B82F6"
                            BorderBrush="{StaticResource BrushCardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} items selected'}"
                                       Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource FluentSubtleButton}" Content="Select All" Command="{Binding SelectAllCommand}" Height="28" Padding="10,2" Margin="0,0,6,0" />
                                <Button Style="{StaticResource FluentSubtleButton}" Content="Favorite" Command="{Binding FavoriteSelectedCommand}" Height="28" Padding="10,2" Margin="0,0,6,0" />
                                <Button Style="{StaticResource FluentSubtleButton}" Content="Delete Selected" Command="{Binding DeleteSelectedCommand}" Height="28" Padding="10,2" Margin="0,0,6,0" />
                                <Button Style="{StaticResource FluentSubtleButton}" Content="Done" Command="{Binding ToggleMultiSelectCommand}" Height="28" Padding="10,2" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Virtualized History List -->
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemCard"
                                                    Background="#1A1E293B"
                                                    BorderBrush="#20FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,8"
                                                    ContextMenu="{StaticResource ItemContextMenu}"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="cardScale" ScaleX="1.0" ScaleY="1.0" />
                                                        <TranslateTransform x:Name="cardTranslate" X="0" />
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <!-- Left selection indicator pill -->
                                                    <Rectangle x:Name="activeBar"
                                                               Fill="{StaticResource BrushAccent}"
                                                               Width="3" Height="0"
                                                               RadiusX="1.5" RadiusY="1.5"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               Margin="-10,0,0,0"
                                                               Opacity="0" />
                                                    <ContentPresenter />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Linux / GNOME Fluid Hover Animation -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemCard" Property="Background" Value="#33334155" />
                                                    <Setter TargetName="ItemCard" Property="BorderBrush" Value="#603B82F6" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="cardTranslate" Storyboard.TargetProperty="X"
                                                                                 To="3.5" Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleX"
                                                                                 To="1.01" Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleY"
                                                                                 To="1.01" Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="cardTranslate" Storyboard.TargetProperty="X"
                                                                                 To="0" Duration="0:0:0.14">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleX"
                                                                                 To="1.0" Duration="0:0:0.14" />
                                                                <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleY"
                                                                                 To="1.0" Duration="0:0:0.14" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <!-- Tactile Selected -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemCard" Property="Background" Value="#323B82F6" />
                                                    <Setter TargetName="ItemCard" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                    <Setter TargetName="activeBar" Property="Opacity" Value="1" />
                                                    <Setter TargetName="activeBar" Property="Height" Value="24" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ClipboardItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /> <!-- Checkbox (Multi-select) -->
                                        <ColumnDefinition Width="Auto" /> <!-- Visual Indicator / Thumbnail -->
                                        <ColumnDefinition Width="*" />    <!-- Content Details -->
                                        <ColumnDefinition Width="Auto" /> <!-- Quick Actions -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Multi-Select Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                                    <!-- Rich Thumbnail Preview Tile (46x46) -->
                                    <Border Grid.Column="1"
                                            Width="46" Height="46"
                                            CornerRadius="8"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            ClipToBounds="True"
                                            Background="#251E293B"
                                            BorderBrush="#25FFFFFF"
                                            BorderThickness="1">
                                        <Grid>
                                            <!-- 1. Real Image Thumbnail (if image or image file) -->
                                            <Image Source="{Binding ThumbnailSource}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasImageThumbnail, Converter={StaticResource BoolToVis}}" />

                                            <!-- 2. System File Icon (if non-image file) -->
                                            <Grid Visibility="{Binding HasSystemFileIcon, Converter={StaticResource BoolToVis}}">
                                                <Image Source="{Binding ThumbnailSource}"
                                                       Width="28" Height="28"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border Background="#D00F172A" CornerRadius="3" Padding="3,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                                                    <TextBlock Text="{Binding FileExtension}" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" />
                                                </Border>
                                            </Grid>

                                            <!-- 3. Color Swatch (if HEX/RGB) -->
                                            <Grid Visibility="{Binding HasColorPreview, Converter={StaticResource BoolToVis}}">
                                                <Border Background="#30FFFFFF" />
                                                <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="2" CornerRadius="6" />
                                                <Border Background="#90000000" CornerRadius="3" Padding="3,1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding ColorHex}" FontSize="8" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </Grid>

                                            <!-- 4. URL / Link Badge -->
                                            <Grid Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}">
                                                <Border CornerRadius="7">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#0284C7" Offset="0" />
                                                            <GradientStop Color="#1D4ED8" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                        <Path Data="{StaticResource IconLink}" Fill="White" Width="18" Height="18" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
                                                        <Border Background="#80000000" CornerRadius="3" Padding="3,0"
                                                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                                            <TextBlock Text="LINK" FontSize="8" FontWeight="Bold" Foreground="#E0F2FE" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- 5. Code Snippet Badge -->
                                            <Grid Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                                                <Border Background="#1E1B4B" CornerRadius="7" BorderBrush="#7C3AED" BorderThickness="1">
                                                    <Grid>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&lt;/&gt;" FontSize="13" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding CodeLanguage}" FontSize="8" FontWeight="SemiBold" Foreground="#DDD6FE" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- 6. File Drop Badge (fallback if no system icon) -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsFileDrop}" Value="True" />
                                                                    <Condition Binding="{Binding HasImageThumbnail}" Value="False" />
                                                                    <Condition Binding="{Binding HasSystemFileIcon}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Border Background="#C2410C" CornerRadius="7">
                                                    <Grid>
                                                        <Path Data="{StaticResource IconFolder}" Fill="White" Width="18" Height="18" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
                                                        <Border Background="#80000000" CornerRadius="3" Padding="3,0"
                                                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding FileExtension}" FontSize="8" FontWeight="Bold" Foreground="#FED7AA" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- 7. Plain Text Document Badge (with mini text lines preview!) -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasImageThumbnail}" Value="False" />
                                                                    <Condition Binding="{Binding HasSystemFileIcon}" Value="False" />
                                                                    <Condition Binding="{Binding HasColorPreview}" Value="False" />
                                                                    <Condition Binding="{Binding IsUrl}" Value="False" />
                                                                    <Condition Binding="{Binding IsCode}" Value="False" />
                                                                    <Condition Binding="{Binding IsFileDrop}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Border Background="#1E293B" CornerRadius="7" BorderBrush="#334155" BorderThickness="1" Padding="7,8">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Rectangle Fill="#94A3B8" Height="3" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Width="26" Margin="0,0,0,3.5" />
                                                        <Rectangle Fill="#64748B" Height="2" RadiusX="1" RadiusY="1" HorizontalAlignment="Left" Width="30" Margin="0,0,0,2.5" />
                                                        <Rectangle Fill="#64748B" Height="2" RadiusX="1" RadiusY="1" HorizontalAlignment="Left" Width="22" Margin="0,0,0,2.5" />
                                                        <Rectangle Fill="#475569" Height="2" RadiusX="1" RadiusY="1" HorizontalAlignment="Left" Width="14" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Content Text / Summary -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />

                                        <!-- Subtitle: Time & Source App -->
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Background="{Binding ContentType, Converter={StaticResource ContentTypeToBadgeColor}}"
                                                    Opacity="0.25" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding TypeDisplayName}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding ContentType, Converter={StaticResource ContentTypeToBadgeColor}}" />
                                            </Border>
                                            <TextBlock Text="{Binding RelativeTime}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text=" • "
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding SourceApplication, FallbackValue='Clipboard'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text=" • "
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding FormattedSize}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Quick Action Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <!-- Favorite Button -->
                                        <Button Style="{StaticResource FluentIconButton}"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Toggle Favorite">
                                            <Path Width="13" Height="13" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource IconStarOutline}" />
                                                        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource IconStar}" />
                                                                <Setter Property="Fill" Value="#EAB308" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>

                                        <!-- Pin Button -->
                                        <Button Style="{StaticResource FluentIconButton}"
                                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Toggle Pin to Top">
                                            <Path Width="13" Height="13" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource IconPinOutline}" />
                                                        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource IconPin}" />
                                                                <Setter Property="Fill" Value="{StaticResource BrushAccent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>

                                        <!-- Copy Button -->
                                        <Button Style="{StaticResource FluentIconButton}"
                                                Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Copy to Clipboard">
                                            <Path Data="{StaticResource IconCopy}" Fill="{StaticResource BrushTextSecondary}" Width="13" Height="13" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- PREVIEW PANEL -->
                <Border Grid.Column="2"
                        Background="#0DFFFFFF"
                        BorderBrush="{StaticResource BrushCardBorder}"
                        BorderThickness="1,0,0,0"
                        Padding="14">
                    <Grid>
                        <!-- When an item is selected -->
                        <Grid Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Header & Badges -->
                                <RowDefinition Height="*" />    <!-- Content Preview -->
                                <RowDefinition Height="Auto" /> <!-- Metadata -->
                                <RowDefinition Height="Auto" /> <!-- Primary Action -->
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border Background="{Binding SelectedItem.ContentType, Converter={StaticResource ContentTypeToBadgeColor}}"
                                            CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SelectedItem.TypeDisplayName}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedItem.RelativeTime, StringFormat='{}Copied {0}'}"
                                               FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource FluentIconButton}"
                                            Command="{Binding DeleteItemCommand}" CommandParameter="{Binding SelectedItem}" ToolTip="Delete Item">
                                        <Path Data="{StaticResource IconTrash}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Content Preview Body -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Color Swatch & Values (if Color) -->
                                    <StackPanel Visibility="{Binding SelectedItem.HasColorPreview, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <Border Height="80" CornerRadius="8" Background="{Binding SelectedItem.ColorHex, Converter={StaticResource HexToBrush}}"
                                                BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding SelectedItem.ColorHex, StringFormat='{}HEX: {0}'}"
                                                   FontFamily="{StaticResource FluentCodeFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding SelectedItem.ColorRgb, StringFormat='{}RGB: {0}'}"
                                                   FontFamily="{StaticResource FluentCodeFont}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Image Preview (if Image or Image File) -->
                                    <StackPanel Visibility="{Binding SelectedItem.HasImageThumbnail, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <Border MaxHeight="220" CornerRadius="8" Background="#10000000" ClipToBounds="True" Margin="0,0,0,8">
                                            <Image Source="{Binding SelectedItem.ThumbnailSource}" Stretch="Uniform" />
                                        </Border>
                                        <Button Style="{StaticResource FluentSubtleButton}" Content="Save Image As..."
                                                Command="{Binding SaveImageAsCommand}" CommandParameter="{Binding SelectedItem}"
                                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- URL Preview (if URL) -->
                                    <StackPanel Visibility="{Binding SelectedItem.IsUrl, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding SelectedItem.Domain, StringFormat='{}Domain: {0}'}"
                                                   FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushAccent}" />
                                        <Button Style="{StaticResource FluentSubtleButton}" Content="Open in Default Browser"
                                                Command="{Binding OpenUrlCommand}" CommandParameter="{Binding SelectedItem.TextContent}"
                                                HorizontalAlignment="Left" Margin="0,6,0,0" />
                                    </StackPanel>

                                    <!-- File Drop List (if Files) -->
                                    <StackPanel Visibility="{Binding SelectedItem.IsFileDrop, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding SelectedItem.FileCount, StringFormat='{}Files ({0}):'}"
                                                   FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding SelectedItem.FilePaths}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Text / Code Preview Content -->
                                    <Border Background="#151E293B" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <TextBox Text="{Binding SelectedItem.TextContent, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource BrushTextPrimary}"
                                                 BorderThickness="0"
                                                 TextWrapping="Wrap"
                                                 FontFamily="{Binding SelectedItem.IsCode, Converter={x:Null}, FallbackValue='Segoe UI'}"
                                                 FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Metadata details -->
                            <Border Grid.Row="2" Background="#10FFFFFF" CornerRadius="6" Padding="10" Margin="0,10,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,10,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.FormattedSize}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Used:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,10,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.UseCount, StringFormat='{}{0} times'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Source:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,10,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.SourceApplication, FallbackValue='None'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>

                            <!-- Primary Action Bar -->
                            <Button Grid.Row="3"
                                    Style="{StaticResource FluentPrimaryButton}"
                                    Command="{Binding CopyItemCommand}"
                                    CommandParameter="{Binding SelectedItem}"
                                    Height="36">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCopy}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Copy to Clipboard" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Empty State when nothing is selected -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding SelectedItem, Converter={StaticResource InverseNullToVis}}">
                            <Path Data="{StaticResource IconAll}" Fill="{StaticResource BrushTextMuted}" Width="40" Height="40" Stretch="Uniform" Margin="0,0,0,12" />
                            <TextBlock Text="No item selected" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                            <TextBlock Text="Select an entry to view full details" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. SETTINGS OVERLAY MODAL -->
            <Border Grid.Row="1"
                    Background="#F00F172A"
                    CornerRadius="0,0,10,10"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Settings Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="ClipFlow Settings" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        <Button Style="{StaticResource FluentIconButton}"
                                Command="{Binding CloseSettingsCommand}"
                                HorizontalAlignment="Right">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Settings Tabs / Content -->
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <!-- Appearance Tab -->
                        <TabItem Header="Appearance" Foreground="{StaticResource BrushTextPrimary}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,16">
                                    <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                                        <RadioButton Content="Dark" IsChecked="True" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,0" />
                                        <RadioButton Content="Light" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,0" />
                                        <RadioButton Content="System" Foreground="{StaticResource BrushTextPrimary}" />
                                    </StackPanel>

                                    <TextBlock Text="Backdrop Material" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                                        <RadioButton Content="Acrylic" IsChecked="True" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,0" />
                                        <RadioButton Content="Mica" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,0" />
                                        <RadioButton Content="Solid" Foreground="{StaticResource BrushTextPrimary}" />
                                    </StackPanel>

                                    <TextBlock Text="Background Opacity" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                                    <Slider Minimum="0.5" Maximum="1.0" Value="{Binding Settings.BackgroundOpacity}" SmallChange="0.05" Margin="0,8,0,16" Width="300" HorizontalAlignment="Left" />

                                    <CheckBox Content="Compact History View" IsChecked="{Binding Settings.CompactView}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                                    <CheckBox Content="Always On Top" IsChecked="{Binding Settings.AlwaysOnTop}" Foreground="{StaticResource BrushTextPrimary}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- General & Behavior Tab -->
                        <TabItem Header="General" Foreground="{StaticResource BrushTextPrimary}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,16">
                                    <CheckBox Content="Start with Windows" IsChecked="{Binding Settings.StartWithWindows}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                                    <CheckBox Content="Minimize to System Tray on Close" IsChecked="{Binding Settings.MinimizeToTrayOnClose}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                                    <CheckBox Content="Start Minimized" IsChecked="{Binding Settings.StartMinimized}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                                    <CheckBox Content="Show Notification Toasts" IsChecked="{Binding Settings.ShowNotifications}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                                    <CheckBox Content="Play Sound on Copy" IsChecked="{Binding Settings.PlaySoundOnCopy}" Foreground="{StaticResource BrushTextPrimary}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Hotkeys Tab -->
                        <TabItem Header="Hotkeys" Foreground="{StaticResource BrushTextPrimary}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,16">
                                    <TextBlock Text="Toggle ClipFlow Window" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBox Style="{StaticResource FluentInputTextBox}" Text="{Binding Settings.ToggleWindowHotkey, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" Margin="0,6,0,16" />

                                    <TextBlock Text="Quick Clear History" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBox Style="{StaticResource FluentInputTextBox}" Text="{Binding Settings.ClearHistoryHotkey, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" Margin="0,6,0,16" />

                                    <TextBlock Text="Toggle Monitoring" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBox Style="{StaticResource FluentInputTextBox}" Text="{Binding Settings.ToggleMonitoringHotkey, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" Margin="0,6,0,16" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Privacy & Security Tab -->
                        <TabItem Header="Privacy &amp; Security" Foreground="{StaticResource BrushTextPrimary}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,16">
                                    <CheckBox Content="Enable Clipboard Monitoring" IsChecked="{Binding Settings.IsMonitoringEnabled}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                                    <CheckBox Content="Filter Sensitive Content (passwords, tokens, private keys, credit cards)" IsChecked="{Binding Settings.FilterSensitiveContent}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                                    <CheckBox Content="Protect Against Password Managers (KeePass, 1Password, Bitwarden format flags)" IsChecked="{Binding Settings.IgnorePasswordManagerFormats}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />

                                    <TextBlock Text="Excluded Applications (Ignore clipboard copies from these processes):" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Style="{StaticResource FluentInputTextBox}" Text="{Binding NewExcludedAppName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource FluentSubtleButton}" Content="Add Process" Command="{Binding AddExcludedAppCommand}" />
                                    </StackPanel>

                                    <!-- Excluded Apps List -->
                                    <Border Background="#15FFFFFF" CornerRadius="6" Padding="6" MaxHeight="140" Width="380" HorizontalAlignment="Left">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ExcludedApps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="4,2">
                                                            <TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                            <Button Style="{StaticResource FluentIconButton}"
                                                                    Command="{Binding DataContext.RemoveExcludedAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalAlignment="Right" Width="24" Height="24">
                                                                <Path Data="{StaticResource IconClose}" Fill="#EF4444" Width="10" Height="10" Stretch="Uniform" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Storage & Maintenance Tab -->
                        <TabItem Header="Storage &amp; Maintenance" Foreground="{StaticResource BrushTextPrimary}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,16">
                                    <TextBlock Text="History Retention Limit" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="{Binding Settings.MaxHistoryItems, StringFormat='{}Keep up to {0} items'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,6" />
                                    <Slider Minimum="100" Maximum="5000" Value="{Binding Settings.MaxHistoryItems}" SmallChange="100" Margin="0,0,0,16" Width="300" HorizontalAlignment="Left" />

                                    <TextBlock Text="Automatic Cleanup Age (Days)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="{Binding Settings.AutoCleanupDays, StringFormat='{}Delete unpinned items older than {0} days'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,6" />
                                    <Slider Minimum="0" Maximum="180" Value="{Binding Settings.AutoCleanupDays}" SmallChange="7" Margin="0,0,0,16" Width="300" HorizontalAlignment="Left" />

                                    <!-- Maintenance Action Buttons -->
                                    <TextBlock Text="Database Operations" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,8" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource FluentSubtleButton}" Content="Run Auto-Cleanup Now" Command="{Binding RunCleanupNowCommand}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource FluentSubtleButton}" Content="Vacuum &amp; Optimize DB" Command="{Binding VacuumDatabaseCommand}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource FluentSubtleButton}" Content="Backup Database..." Command="{Binding BackupDatabaseCommand}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource FluentSubtleButton}" Content="Restore Database..." Command="{Binding RestoreDatabaseCommand}" Margin="0,0,8,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- About Tab -->
                        <TabItem Header="About" Foreground="{StaticResource BrushTextPrimary}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,16">
                                    <TextBlock Text="ClipFlow — Smart Clipboard Manager" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="Version 1.0.0 (Production Release)" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,12" />
                                    <TextBlock Text="ClipFlow is a privacy-first Windows 11 clipboard manager designed with Fluent glassmorphism, local SQLite storage, smart content recognition, and zero external telemetry."
                                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" Margin="0,0,0,16" />
                                    <Border Background="#1522C55E" CornerRadius="6" Padding="12" MaxWidth="500" HorizontalAlignment="Left">
                                        <TextBlock Text="✓ 100% Local Storage. No cloud dependency, no tracking, no telemetry."
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#4ADE80" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- Settings Footer Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource FluentSubtleButton}" Content="Reset to Defaults" Command="{Binding ResetSettingsCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource FluentPrimaryButton}" Content="Save Settings" Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. TOAST NOTIFICATION CARD with Linux fluid bounce animation -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#F01E293B"
                    BorderBrush="{StaticResource BrushAccent}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18,9"
                    Margin="0,0,0,24"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="toastTrans" Y="0" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="20" To="0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCheck}" Fill="#22C55E" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
